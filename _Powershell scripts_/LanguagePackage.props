<Project>
  <PropertyGroup>
	<TesseractOCRLanguageDataDirectory Condition="'$(TesseractOCRLanguageDataDirectory)' == ''">tessdata</TesseractOCRLanguageDataDirectory>
  </PropertyGroup>
  <ItemGroup>
	<TesseractOCRLanguageModel Include="$(MSBuildThisFileDirectory)..\tessdata\**\*.traineddata" />
  </ItemGroup>
  <Target Name="CopyTesseractOCRLanguageModelsToOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
	<Copy SourceFiles="@(TesseractOCRLanguageModel)" DestinationFiles="@(TesseractOCRLanguageModel->'$(OutDir)$(TesseractOCRLanguageDataDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyTesseractOCRLanguageModelsToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
	<Copy SourceFiles="@(TesseractOCRLanguageModel)" DestinationFiles="@(TesseractOCRLanguageModel->'$(PublishDir)$(TesseractOCRLanguageDataDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
