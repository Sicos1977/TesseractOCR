{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "TesseractOCR.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "**/*.md",
          "**/toc.yml"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "TesseractOCR",
      "_appTitle": "TesseractOCR API Documentation",
      "_disableToc": false,
      "_appFooter": "TesseractOCR documentation",
      "_disableNavbar": false,
      "_disableContribution": true,
      "_enableSearch": true,
      "pdf": false
    }
  }
}